+package ss
+
+import (
+ "bytes"
+ "io"
+ "math"
+ "testing"
+)
+func TestRecordWorkspaceBoundAndClear(t *testing.T){
+ for{select{case <-recordWorkspaces:default:goto drained}}
+ drained:
+ var held []*[recordWorkspaceBytes]byte
+ for i:=0;i<recordWorkspaceSlots+8;i++{p:=takeRecordWorkspace();for j:=range p{p[j]=0x77};held=append(held,p)}
+ for _,p:=range held{releaseRecordWorkspace(p)}
+ if len(recordWorkspaces)!=recordWorkspaceSlots{t.Fatal("unbounded/incorrect cache")}
+ for i:=0;i<recordWorkspaceSlots;i++{p:=takeRecordWorkspace();if !bytes.Equal(p[:],make([]byte,recordWorkspaceBytes)){t.Fatal("plaintext/ciphertext retained across owners")}}
+}
+func TestRecord2017PendingHasPrivateOwnership(t *testing.T){
+ for _,name:=range methods[:3]{s:=server(t,name);a,e:=s.aead(seq(3,s.m.keySize));if e!=nil{t.Fatal(e)};payload:=bytes.Repeat([]byte{0x42},MaxChunk2017);var nonce counter;h,_:=seal(a,&nonce,[]byte{0x3f,0xff});b,_:=seal(a,&nonce,payload);r:=recordReader{r:bytes.NewReader(append(h,b...)),aead:a,max:MaxChunk2017};first:=make([]byte,7);if n,e:=r.Read(first);e!=nil||n!=7{t.Fatal(n,e)};workspace:=takeRecordWorkspace();clear(workspace[:]);releaseRecordWorkspace(workspace);rest,e:=io.ReadAll(&r);if e!=nil||!bytes.Equal(append(first,rest...),payload){t.Fatal("pending aliased pool",e)};if r.pending!=nil{t.Fatal("consumed plaintext retained")}}
+}
+func TestRecord2017WorkspaceNonceAndTag(t *testing.T){
+ s:=server(t,AES128GCM);a,_:=s.aead(seq(4,16));n:=counter{exhausted:true};if _,e:=sealAppend(a,&n,nil,[]byte("x"));e!=ErrNonceExhausted{t.Fatal(e)};if _,e:=openInPlace(a,&n,make([]byte,16));e!=ErrNonceExhausted{t.Fatal(e)}
+ n=counter{};for i:=range n.value{n.value[i]=math.MaxUint8};if _,e:=sealAppend(a,&n,make([]byte,0,64),[]byte("x"));e!=nil||!n.exhausted{t.Fatal("nonce did not exhaust",e)}
+ n=counter{};if _,e:=openInPlace(a,&n,make([]byte,32));e!=ErrAuth||n.value!=[12]byte{}{t.Fatal("bad tag advanced nonce",e)}
